# Node dependencies
node_modules/

# Environment variables
.env

# PixyMoon assets – the art pack files are not checked into git.
# The generated `asset-manifest.json` IS checked in so a fresh clone
# has a working sprite map even before `npm run build-assets` runs.
assets/pixymoon/*
!assets/pixymoon/**/.gitkeep
!assets/pixymoon/.gitkeep
!assets/pixymoon/README.md
!assets/pixymoon/Cute RPG World/
/assets/pixymoon/Cute\ RPG\ World/*
!/assets/pixymoon/Cute\ RPG\ World/asset-manifest.json

# Mac and editor junk
.DS_Store
.vscode/

# Daemon logs
logs/
output.log

# Playwright outputs
test-results/
playwright-report/

# Per-install world layout — auto-seeded on first server start from
# adapter/worldModel.js + adapter/treeGenerator.js defaults. Users
# keep their local edits; the repo doesn't ship a baseline.
data/world-layout.json

# Per-install repo → building assignments, generated by claudeSnapshotter.
data/repoAssignments.json

# Paperclip Files
MEMORY.md
memory
docs
SOUL.md
USER.md
.agents
.qa-artifacts
