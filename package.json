{
  "name": "agent-world",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "npm run test:all",
    "test:unit": "node --test test/paperclipAdapter.test.js test/eventsPipeline.test.js",
    "test:request": "node --test test/eventsApi.request.test.js",
    "test:integration": "node --test test/eventsApi.integration.test.js",
    "test:e2e": "node --test test/eventsApi.e2e.test.js",
    "test:smoke": "npm run test:unit && npm run test:request && npm run test:integration && npm run test:e2e",
    "test:all": "npm run test:smoke"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0"
  }
}
